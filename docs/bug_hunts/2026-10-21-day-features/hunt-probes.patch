+    void huntPromptMath()   // HUNT
+    {
+        skipWithoutShell();
+        ClaudeCodePanel panel;
+        panel.setDefaultDirectory(fresh("huntprompt"));
+        panel.session()->setProgram(script("switcher", kSwitcher));
+        panel.resize(440, 700);
+        panel.show();
+        QVERIFY(QTest::qWaitForWindowExposed(&panel));
+        const QStringList prompts = {
+            "Compare <b>x</b> &amp; y < z with $\\alpha$ here",
+            "Price $5 and $10, with $\\beta$",
+            "A path C:\\Users\\$HOME\\x$ and $\\gamma$",
+            "Line one $a$\n<!-- not a comment -->\nline three $$b$$ end",
+        };
+        for (const QString& p : prompts) {
+            panel.composer()->setPlainText(p);
+            panel.sendComposer();
+            QTRY_VERIFY_WITH_TIMEOUT(!panel.session()->isBusy(), 10000);
+            panel.renderNow();
+        }
+        const QString text = panel.transcriptText();
+        for (const QString& want : {QStringLiteral("<b>x</b>"), QStringLiteral("&amp;"), QStringLiteral("< z"), QStringLiteral("$5 and $10"),
+                                    QStringLiteral("C:\\Users\\$HOME\\x$"), QStringLiteral("<!-- not a comment -->")})
+            qInfo("HUNT shown as typed %s: %d", qPrintable(want), int(text.contains(want)));
+        qInfo("HUNT formulas (object marks) in the transcript: %lld", text.count(QChar::ObjectReplacementCharacter));
+        panel.session()->stop();
+    }
