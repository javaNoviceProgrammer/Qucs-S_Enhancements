+    void huntMathReply()   // HUNT
+    {
+        for (const auto& [replies, each] : {std::pair{10, 25}, std::pair{40, 25}}) {
+            ClaudeCodePanel panel;
+            panel.setDefaultDirectory(fresh(QStringLiteral("huntmathc%1").arg(replies)));
+            panel.session()->setProgram("claude");
+            panel.resize(440, 700);
+            panel.show();
+            QVERIFY(QTest::qWaitForWindowExposed(&panel));
+            for (int r = 0; r < replies; ++r) {
+                QString text = QStringLiteral("Reply %1:").arg(r);
+                for (int i = 0; i < each; ++i) text += QStringLiteral(" with $E_{%1} = \\hbar\\omega_{%1}$,").arg(i);
+                const QJsonObject m{{"type", "assistant"}, {"message", QJsonObject{{"content", QJsonArray{QJsonObject{{"type", "text"}, {"text", text}}}}}}};
+                panel.session()->handleLine(QJsonDocument(m).toJson(QJsonDocument::Compact));
+            }
+            QElapsedTimer t; t.start();
+            panel.renderNow();
+            qInfo("HUNT %d replies of %d formulas: a render %lld ms", replies, each, t.elapsed());
+        }
+        if (qEnvironmentVariableIsSet("HUNT_SPREAD_ONLY")) return;
+        for (int n : {250, 500, 1000, 2000}) {
+            ClaudeCodePanel panel;
+            panel.setDefaultDirectory(fresh(QStringLiteral("huntmath%1").arg(n)));
+            panel.session()->setProgram("claude");   // (not run)
+            panel.resize(440, 700);
+            panel.show();
+            QVERIFY(QTest::qWaitForWindowExposed(&panel));
+            QString text = "Here:";
+            for (int i = 0; i < n; ++i) text += QStringLiteral(" term $x_{%1}^2$ and").arg(i);
+            const QJsonObject m{{"type", "assistant"}, {"message", QJsonObject{{"content", QJsonArray{QJsonObject{{"type", "text"}, {"text", text}}}}}}};
+            panel.session()->handleLine(QJsonDocument(m).toJson(QJsonDocument::Compact));
+            QElapsedTimer t; t.start();
+            panel.renderNow();
+            const qint64 first = t.elapsed();
+            t.start();
+            panel.renderNow();
+            const qint64 again = t.elapsed();
+            // A note appended: the transcript drawn again.
+            panel.addNote("a note");
+            t.start();
+            panel.renderNow();
+            qInfo("HUNT %d formulas in one reply: render %lld ms, again %lld ms, after a note %lld ms", n, first, again, t.elapsed());
+        }
+    }
