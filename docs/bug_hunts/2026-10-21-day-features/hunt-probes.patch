+    void huntBackgroundRace()   // HUNT
+    {
+        skipWithoutShell();
+        // Refused (not a task yet), but the task announced just before the refusal reaches the dock.
+        QFile::remove(dir.filePath("race-in"));
+        Session s;
+        s.setProgram(script("racer", kHuntRace));
+        s.setWorkingDirectory(fresh("racework"));
+        QSignalSpy tools(&s, &Session::toolStarted);
+        QSignalSpy notices(&s, &Session::notice);
+        QSignalSpy turns(&s, &Session::turnFinished);
+        QVERIFY(s.send("Build it"));
+        QVERIFY(tools.wait(10000));
+        QCOMPARE(s.sendToBackground(), 1);
+        QTest::qWait(1500);
+        QStringList said;
+        for (const QList<QVariant>& n : std::as_const(notices)) said << n.at(0).toString();
+        qInfo("HUNT notices: [%s]; turn ended %d; can send again %d; asked %lld times", qPrintable(said.join(" | ")), int(turns.count()),
+              int(s.canSendToBackground()), read(dir.filePath("race-in")).count("background_tasks"));
+        s.stop();
+    }
