+    // PROBE P9: a later page at an odd zoom - its top at a fraction of a
+    // pixel - on the GPU against the CPU.
+    void probeLaterPageSharp()
+    {
+        if (!qucs_s::gpu::hindrance().isEmpty()) QSKIP("no GPU");
+        QVERIFY(app->gotoPage(file));
+        PdfDoc* doc = pdf();
+        PageView* view = doc->view();
+        const struct Back {
+            ~Back() { QucsSettingsFile().remove(qucs_s::gpu::settingKey(qucs_s::gpu::Viewer::Pdf)); }
+        } back;
+        for (const qreal zoom : {1.0, 1.37, 1.53, 2.11}) {
+            qucs_s::gpu::setWanted(qucs_s::gpu::Viewer::Pdf, false);
+            view->setZoom(zoom);
+            view->goToPage(2);
+            const QImage cpu = shown(view);
+            qucs_s::gpu::setWanted(qucs_s::gpu::Viewer::Pdf, true);
+            const int rendered0 = view->tilesRendered(), scaled0 = view->tilesScaled();
+            QImage gpu = shown(view);
+            qInfo("  after shown: zooming %d, tiles rendered +%d, scaled +%d, zoom %.3f", view->zooming(), view->tilesRendered() - rendered0, view->tilesScaled() - scaled0, view->zoom());
+            const int rendered1 = view->tilesRendered(), scaled1 = view->tilesScaled();
+            QTest::qWait(1500);
+            const QImage later = view->viewport()->grab().toImage().convertToFormat(QImage::Format_RGB32);
+            qInfo("  1.5 s later: tiles rendered +%d, scaled +%d, the frame %s", view->tilesRendered() - rendered1, view->tilesScaled() - scaled1, later == gpu ? "the same" : "changed");
+            gpu = later;
+            int apart = 0, greyCpu = 0, greyGpu = 0;
+            for (int y = 0; y < cpu.height(); ++y)
+                for (int x = 0; x < cpu.width(); ++x) {
+                    const QColor a = cpu.pixelColor(x, y), b = gpu.pixelColor(x, y);
+                    apart += std::abs(a.red() - b.red()) + std::abs(a.green() - b.green()) + std::abs(a.blue() - b.blue()) > 24;
+                    greyCpu += a.lightness() > 60 && a.lightness() < 200;
+                    greyGpu += b.lightness() > 60 && b.lightness() < 200;
+                }
+            const QRectF page = view->pageRect(2);
+            qInfo("zoom %.2f: page 3 at y %.3f (device %.3f): %d of %d pixels apart; mid-grey pixels CPU %d, GPU %d", zoom,
+                  page.top(), page.top() * view->viewport()->devicePixelRatioF(), apart, cpu.width() * cpu.height(), greyCpu, greyGpu);
+            if (!qEnvironmentVariable("QUCS_TEST_SHOTS").isEmpty()) {
+                cpu.save(qEnvironmentVariable("QUCS_TEST_SHOTS") + QStringLiteral("/p3_cpu_%1.png").arg(zoom));
+                gpu.save(qEnvironmentVariable("QUCS_TEST_SHOTS") + QStringLiteral("/p3_gpu_%1.png").arg(zoom));
+            }
+        }
+    }
