+    // PROBE P14: the GPU's viewport switched during a zoom's steps and a
+    // pinch, the file reloaded mid-zoom, the tab closed mid-zoom.
+    void probePdfStress()
+    {
+        if (!qucs_s::gpu::hindrance().isEmpty()) QSKIP("no GPU");
+        const struct Back {
+            ~Back() { QucsSettingsFile().remove(qucs_s::gpu::settingKey(qucs_s::gpu::Viewer::Pdf)); }
+        } back;
+        for (int round = 0; round < 4; ++round) {
+            QVERIFY(app->gotoPage(file));
+            PdfDoc* doc = pdf();
+            PageView* view = doc->view();
+            const QPoint mid = view->viewport()->rect().center();
+            for (int k = 0; k < 14; ++k) {
+                qucs_s::gpu::setWanted(qucs_s::gpu::Viewer::Pdf, k % 3 != 1);
+                if (k % 2) {
+                    QNativeGestureEvent e(Qt::ZoomNativeGesture, QPointingDevice::primaryPointingDevice(), 2, QPointF(mid), QPointF(mid),
+                                          view->viewport()->mapToGlobal(QPointF(mid)), k < 7 ? 0.08 : -0.08, QPointF());
+                    QCoreApplication::sendEvent(view->viewport(), &e);
+                } else {
+                    view->setZoom(view->zoom() * (k < 7 ? 1.3 : 0.8));
+                }
+                if (k == 9) doc->reload();
+                QTest::qWait(k % 4 * 12);
+            }
+            qucs_s::gpu::setWanted(qucs_s::gpu::Viewer::Pdf, true);
+            QNativeGestureEvent e(Qt::ZoomNativeGesture, QPointingDevice::primaryPointingDevice(), 2, QPointF(mid), QPointF(mid),
+                                  view->viewport()->mapToGlobal(QPointF(mid)), 0.1, QPointF());
+            QCoreApplication::sendEvent(view->viewport(), &e);
+            app->slotFileClose(app->DocumentTab->indexOf(doc));
+            QTest::qWait(round % 2 ? 0 : 150);
+        }
+        qInfo("pdf stress done");
+    }
