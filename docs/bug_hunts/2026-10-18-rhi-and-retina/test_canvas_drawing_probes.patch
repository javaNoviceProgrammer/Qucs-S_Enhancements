+    // PROBE (the user's fan1998 page): every graph's lines painted against
+    // those meeting the canvas, at several zooms.
+    void probeUserPage()
+    {
+        const QString from = qEnvironmentVariable("QUCS_PROBE_DIR");
+        const QString page = qEnvironmentVariable("QUCS_PROBE_PAGE");
+        if (from.isEmpty()) QSKIP("QUCS_PROBE_DIR not set");
+        for (const QString& name : QDir(from).entryList({QStringLiteral("*.dat"), QStringLiteral("*.dpl")}, QDir::Files)) {
+            QFile::remove(dir.filePath(name));
+            QVERIFY(QFile::copy(from + "/" + name, dir.filePath(name)));
+        }
+        QucsApp app(false);
+        MainGuard guard(&app);
+        Schematic* s = open(app, dir.filePath(page), {1400, 1000});
+        QVERIFY(s != nullptr);
+        qInfo("ratio %g; %d diagrams", s->viewport()->devicePixelRatioF(), int(s->a_DocDiags.size()));
+        for (Diagram* d : s->a_DocDiags) {
+            QString g;
+            for (const Graph* gr : d->Graphs) g += QStringLiteral(" %1(%2 lines)").arg(gr->Var).arg(gr->drawnLines().size());
+            qInfo("diagram at %d %d, %d by %d:%s", d->cx, d->cy, d->x2, d->y2, qPrintable(g));
+        }
+        for (const double scale : {1.0, 1.5, 2.0, 3.0}) {
+            for (Diagram* target : s->a_DocDiags) {
+                s->zoomBy(scale / s->getScale());
+                s->centerOn(QPoint(target->cx + target->x2 / 2, target->cy - target->y2 / 2));
+                pump();
+                s->viewport()->repaint();
+                const QRectF seen = QRectF(s->viewportToModel(QPoint(0, 0)), s->viewportToModel(QPoint(s->viewport()->width(), s->viewport()->height()))).normalized();
+                QString line = QStringLiteral("scale %1, centred on %2:").arg(s->getScale()).arg(target->cy);
+                for (Diagram* d : s->a_DocDiags)
+                    for (const Graph* g : d->Graphs) {
+                        int meet = 0;
+                        for (const QLineF& l : g->drawnLines()) {
+                            const QRectF box = QRectF(QPointF(d->cx + l.x1(), d->cy - l.y1()), QPointF(d->cx + l.x2(), d->cy - l.y2())).normalized();
+                            if (box.adjusted(-1, -1, 1, 1).intersects(seen)) ++meet;
+                        }
+                        if (g->linesPainted() < meet) line += QStringLiteral(" [%1 %2: %3 painted < %4 in sight]").arg(d->cy).arg(g->Var).arg(g->linesPainted()).arg(meet);
+                    }
+                qInfo("%s", qPrintable(line));
+                if (!qEnvironmentVariable("PROBE_SHOTS").isEmpty() && scale == 1.0)
+                    s->viewport()->grab().save(qEnvironmentVariable("PROBE_SHOTS") + QStringLiteral("/fan_%1.png").arg(target->cy));
+            }
+        }
+        for (Diagram* d : s->a_DocDiags)
+            for (const Graph* g : d->Graphs) {
+                double ylo = 1e9, yhi = -1e9, xlo = 1e9, xhi = -1e9;
+                for (const QLineF& l : g->drawnLines()) {
+                    ylo = std::min({ylo, l.y1(), l.y2()}); yhi = std::max({yhi, l.y1(), l.y2()});
+                    xlo = std::min({xlo, l.x1(), l.x2()}); xhi = std::max({xhi, l.x1(), l.x2()});
+                }
+                qInfo("%d %s: lines x %.1f..%.1f y %.1f..%.1f (diagram %d by %d)", d->cy, qPrintable(g->Var), xlo, xhi, ylo, yhi, d->x2, d->y2);
+            }
+    }
