+    // PROBE P4: the preview's GPU viewport switched on and off while it
+    // scrolls and its text changes, its tab closed on the GPU.
+    void probePreviewStress()
+    {
+        if (!qucs_s::gpu::hindrance().isEmpty()) QSKIP("no GPU");
+        QByteArray text = "# Stress\n\n> quote\n\n";
+        for (int i = 0; i < 200; ++i) text += "Line " + QByteArray::number(i) + " of the stress, $x^" + QByteArray::number(i % 5) + "$ math.\n\n";
+        QucsApp app(false);
+        MainGuard guard(&app);
+        app.resize(900, 700);
+        app.show();
+        QVERIFY(QTest::qWaitForWindowExposed(&app));
+        for (int round = 0; round < 6; ++round) {
+            QVERIFY(app.gotoPage(write(QStringLiteral("stress%1.md").arg(round), text)));
+            MarkdownDoc* md = current(app);
+            QVERIFY(md != nullptr);
+            md->setMode(round % 2 ? MarkdownDoc::Mode::Split : MarkdownDoc::Mode::Preview);
+            QTextBrowser* view = md->preview();
+            for (int k = 0; k < 12; ++k) {
+                md->setPreviewGpu(k % 3 != 2);
+                view->verticalScrollBar()->setValue(k * 97);
+                if (k % 4 == 1) md->insertPlainText(QStringLiteral("edit %1 ").arg(k));
+                if (k % 4 == 3) md->renderNow();
+                (void)qucs_s::gpu::shownFrame(view);
+                QTest::qWait(k % 3 * 15);
+            }
+            md->setPreviewGpu(true);
+            QTest::qWait(30);
+            app.slotFileClose(app.DocumentTab->indexOf(md));
+            QTest::qWait(round % 2 ? 0 : 40);
+        }
+        qInfo("preview stress done");
+    }
