+    // PROBE P8: the Graphics view's wheel and pinch keep the point under the pointer.
+    void probeGraphicsAnchor()
+    {
+        auto mesh = gridMesh(20);
+        GraphicsView owner;
+        GraphicsView* view = &owner;
+        view->resize(600, 400);
+        view->setTopology(squareTopology());
+        view->setMesh(mesh);
+        view->setVisible(true);
+        (void)QTest::qWaitForWindowExposed(view, 500);
+        view->fit();
+        const QPoint at(view->width() / 3, view->height() / 3);
+        double worstWheel = 0, worstPinch = 0;
+        int zoomedWheel = 0;
+        for (int k = 0; k < 16; ++k) {
+            const QPointF before = view->toModel(QPointF(at));
+            const double scale = view->scale();
+            if (k % 2) {
+                QNativeGestureEvent e(Qt::ZoomNativeGesture, QPointingDevice::primaryPointingDevice(), 2, QPointF(at), QPointF(at),
+                                      view->mapToGlobal(QPointF(at)), k < 8 ? 0.07 : -0.07, QPointF());
+                QCoreApplication::sendEvent(view, &e);
+            } else {
+                QWheelEvent w(QPointF(at), view->mapToGlobal(QPointF(at)), QPoint(), QPoint(0, k < 8 ? 120 : -120), Qt::NoButton,
+                              k % 4 == 0 ? Qt::NoModifier : Qt::ControlModifier, Qt::NoScrollPhase, false);
+                QCoreApplication::sendEvent(view, &w);
+            }
+            QTest::qWait(5);
+            const double off = QLineF(view->toPixel(before), QPointF(at)).length();
+            if (k % 2) worstPinch = std::max(worstPinch, off);
+            else if (view->scale() != scale) {
+                ++zoomedWheel;
+                worstWheel = std::max(worstWheel, off);
+            }
+        }
+        qInfo("graphics: wheel notches that zoomed %d of 8, worst %.3f px; pinch worst %.3f px (scale now %g)", zoomedWheel, worstWheel, worstPinch, view->scale());
+    }
