+    // PROBE P5: the Graphics view's GPU canvas made and dropped, resized to
+    // nothing, the view deleted while shown.
+    void probeGraphicsStress()
+    {
+        if (!GraphicsView::gpuAvailable()) QSKIP("no GPU");
+        auto mesh = gridMesh(30);
+        for (int round = 0; round < 10; ++round) {
+            auto* view = new GraphicsView;
+            view->setGpu(round % 3 != 1);
+            view->resize(400 + round * 10, 300);
+            view->setTopology(squareTopology());
+            view->setMesh(mesh);
+            view->setVisible(true);
+            (void)QTest::qWaitForWindowExposed(view, 500);
+            if (round % 2) {
+                view->resize(0, 0);
+                QTest::qWait(10);
+                view->resize(300, 200);
+            }
+            for (int k = 0; k < 4; ++k) {
+                view->setGpu(k % 2 == 0);
+                view->zoomBy(1.2);
+                QTest::qWait(10);
+            }
+            if (round % 2) delete view;
+            else view->deleteLater();
+            QTest::qWait(20);
+        }
+        QTest::qWait(50);
+        qInfo("graphics stress done");
+    }
