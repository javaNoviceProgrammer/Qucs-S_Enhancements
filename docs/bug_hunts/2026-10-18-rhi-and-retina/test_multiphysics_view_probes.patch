+    // PROBE P13: a pan's paint of a large Graphics view, the GPU against the CPU.
+    void probeGraphicsBigPan()
+    {
+        if (!GraphicsView::gpuAvailable()) QSKIP("no GPU");
+        const QRect screen = QGuiApplication::primaryScreen()->availableGeometry();
+        for (const int n : {100, 300}) {
+            auto mesh = gridMesh(n);
+            for (const bool gpu : {false, true}) {
+                GraphicsView view;
+                view.setGpu(gpu);
+                view.setGeometry(screen);
+                view.setMesh(mesh);
+                auto scene = sceneOf(*mesh, [](QPointF p) { return std::sin(9 * p.x()) * std::cos(7 * p.y()); }, true);
+                scene->mesh = true;
+                view.setPlot(scene);
+                view.setShow(GraphicsView::Show::Results);
+                view.fit();
+                view.setVisible(true);
+                (void)QTest::qWaitForWindowExposed(&view, 1000);
+                QTest::qWait(300);
+                QWidget* target = gpu ? view.findChild<QWidget*>(QStringLiteral("multiphysicsCanvas")) : static_cast<QWidget*>(&view);
+                struct Timer : QObject {
+                    QList<double> times;
+                    QElapsedTimer t;
+                    bool eventFilter(QObject* o, QEvent* e) override
+                    {
+                        if (e->type() != QEvent::Paint) return false;
+                        t.start();
+                        o->removeEventFilter(this);
+                        QCoreApplication::sendEvent(o, e);
+                        o->installEventFilter(this);
+                        times << t.nsecsElapsed() / 1e6;
+                        return true;
+                    }
+                } timer;
+                target->installEventFilter(&timer);
+                for (int k = 0; k < 16; ++k) {
+                    view.zoomBy(k % 2 ? 1.02 : 1 / 1.02);
+                    QTest::qWait(40);
+                }
+                target->removeEventFilter(&timer);
+                QList<double> t = timer.times;
+                std::sort(t.begin(), t.end());
+                qInfo("%d by %d mesh, %s: view %d by %d at %g, %d paints, median %.1f ms, worst %.1f", n, n, gpu ? "GPU" : "CPU", view.width(), view.height(),
+                      view.devicePixelRatioF(), int(t.size()), t.isEmpty() ? 0.0 : t.at(t.size() / 2), t.isEmpty() ? 0.0 : t.last());
+            }
+        }
+    }
