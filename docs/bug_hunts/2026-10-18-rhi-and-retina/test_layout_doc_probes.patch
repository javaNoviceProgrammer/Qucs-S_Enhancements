+    // PROBE P1: forty layers on the GPU (the uniforms' slots grown past 64).
+    void probeManyLayers()
+    {
+        if (!qucs_s::gpu::hindrance().isEmpty()) QSKIP("no GPU");
+        qucs_s::gpu::setWanted(qucs_s::gpu::Viewer::Layout, true);
+        const struct Back {
+            ~Back() { QucsSettingsFile().remove(qucs_s::gpu::settingKey(qucs_s::gpu::Viewer::Layout)); }
+        } back;
+        const int layers = qEnvironmentVariableIsSet("PROBE_LAYERS") ? qEnvironmentVariableIntValue("PROBE_LAYERS") : 40;
+        const QString file = path(QStringLiteral("many%1.gds").arg(layers));
+        {
+            gdstk::Library lib = {};
+            lib.init("MANY", 1e-6, 1e-9);
+            gdstk::Cell* top = newCell(lib, "MANY");
+            for (int layer = 0; layer < layers; ++layer) {
+                auto* p = static_cast<gdstk::Polygon*>(gdstk::allocate_clear(sizeof(gdstk::Polygon)));
+                p->tag = gdstk::make_tag(uint32_t(layer), 0);
+                const double x = (layer % 8) * 12.0, y = (layer / 8) * 12.0;
+                for (const gdstk::Vec2& v : {gdstk::Vec2{x, y}, gdstk::Vec2{x + 10, y}, gdstk::Vec2{x + 10, y + 10}, gdstk::Vec2{x, y + 10}}) p->point_array.append(v);
+                top->polygon_array.append(p);
+                // a tiny one too: a dot
+                auto* q = static_cast<gdstk::Polygon*>(gdstk::allocate_clear(sizeof(gdstk::Polygon)));
+                q->tag = gdstk::make_tag(uint32_t(layer), 0);
+                for (const gdstk::Vec2& v : {gdstk::Vec2{x + 11, y + 11}, gdstk::Vec2{x + 11.01, y + 11}, gdstk::Vec2{x + 11.01, y + 11.01}}) q->point_array.append(v);
+                top->polygon_array.append(q);
+            }
+            QCOMPARE(lib.write_gds(QFile::encodeName(file).constData(), 0, nullptr), gdstk::ErrorCode::NoError);
+            lib.free_all();
+        }
+        LayoutDoc* doc = open(file);
+        QVERIFY(doc != nullptr);
+        LayoutView* view = doc->view();
+        doc->setGridShown(false);
+        view->resize(640, 480);
+        view->fit();
+        view->setGpu(false);
+        const QImage cpu = view->picture().convertToFormat(QImage::Format_RGB32);
+        view->setGpu(true);
+        QVERIFY(view->gpu());
+        QTRY_VERIFY(view->canvas()->frames() > 0);
+        const QImage gpu = view->picture().convertToFormat(QImage::Format_RGB32);
+        int differ = 0, inked = 0;
+        const QColor paper = cpu.pixelColor(1, 1);
+        for (int y = 0; y < cpu.height(); ++y)
+            for (int x = 0; x < cpu.width(); ++x) {
+                if (cpu.pixel(x, y) != paper.rgb() || gpu.pixel(x, y) != paper.rgb()) ++inked;
+                if (cpu.pixel(x, y) != gpu.pixel(x, y)) ++differ;
+            }
+        const QString shots = qEnvironmentVariable("QUCS_TEST_SHOTS");
+        if (!shots.isEmpty()) {
+            cpu.save(shots + QStringLiteral("/many%1_cpu.png").arg(layers));
+            gpu.save(shots + QStringLiteral("/many%1_gpu.png").arg(layers));
+        }
+        qInfo("%d layers: %d inked, %d differ; frames %d", layers, inked, differ, view->canvas()->frames());
+    }
