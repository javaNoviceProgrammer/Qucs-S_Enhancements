+    // PROBE P6: a pan's paint in a large window, the GPU's layered canvas
+    // against the CPU.
+    void probeBigWindowPan()
+    {
+        if (!qucs_s::gpu::hindrance().isEmpty()) QSKIP("no GPU");
+        qucs_s::gpu::setWanted(qucs_s::gpu::Viewer::Layout, true);
+        const struct Back {
+            ~Back() { QucsSettingsFile().remove(qucs_s::gpu::settingKey(qucs_s::gpu::Viewer::Layout)); }
+        } back;
+        const QRect screen = app->screen()->availableGeometry();
+        app->setGeometry(screen);
+        QTest::qWait(300);
+        QString file = path("sample.gds");
+        if (qEnvironmentVariableIsSet("PROBE_SHAPES")) {
+            const int n = qEnvironmentVariableIntValue("PROBE_SHAPES");
+            file = path(QStringLiteral("shapes%1.gds").arg(n));
+            gdstk::Library lib = {};
+            lib.init("MANY", 1e-6, 1e-9);
+            gdstk::Cell* top = newCell(lib, "MANY");
+            const int side = int(std::sqrt(double(n)));
+            for (int i = 0; i < side; ++i)
+                for (int j = 0; j < side; ++j) addRectangle(top, {i * 2.0, j * 2.0}, {i * 2.0 + 1.3, j * 2.0 + 1.3}, uint32_t((i + j) % 5));
+            QCOMPARE(lib.write_gds(QFile::encodeName(file).constData(), 0, nullptr), gdstk::ErrorCode::NoError);
+            lib.free_all();
+        }
+        LayoutDoc* doc = open(file);
+        QVERIFY(doc != nullptr);
+        QTRY_VERIFY_WITH_TIMEOUT(!doc->isLoading(), 60000);
+        LayoutView* view = doc->view();
+        view->fit();
+        view->setView(view->center(), view->scale() * 3);
+        QTest::qWait(100);
+        for (const bool gpu : {false, true}) {
+            view->setGpu(gpu);
+            QTest::qWait(100);
+            QWidget* target = gpu ? static_cast<QWidget*>(view->canvas()) : static_cast<QWidget*>(view);
+            struct Timer : QObject {
+                QList<double> times;
+                QElapsedTimer t;
+                bool eventFilter(QObject* o, QEvent* e) override
+                {
+                    if (e->type() != QEvent::Paint) return false;
+                    t.start();
+                    static_cast<QWidget*>(o)->removeEventFilter(this);
+                    QCoreApplication::sendEvent(o, e);
+                    static_cast<QWidget*>(o)->installEventFilter(this);
+                    times << t.nsecsElapsed() / 1e6;
+                    return true;
+                }
+            } timer;
+            target->installEventFilter(&timer);
+            for (int k = 0; k < 20; ++k) {
+                view->setView(view->center() + QPointF(k % 2 ? 2 : -2, 0), view->scale());
+                QTest::qWait(40);
+            }
+            target->removeEventFilter(&timer);
+            QList<double>& times = timer.times;
+            if (times.size() < 11) { qInfo("%s: only %d paints", gpu ? "GPU" : "CPU", int(times.size())); continue; }
+            std::sort(times.begin(), times.end());
+            qInfo("%s: view %d by %d at %g: a pan's paint %.1f ms median, %.1f worst", gpu ? "GPU" : "CPU", view->width(), view->height(),
+                  view->devicePixelRatioF(), times.at(10), times.last());
+        }
+        app->resize(1200, 800);
+    }
