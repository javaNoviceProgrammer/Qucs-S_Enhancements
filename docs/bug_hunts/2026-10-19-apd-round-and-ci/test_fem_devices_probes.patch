+            qInfo("uniform bar %s V: In %.4g Ip %.4g Mn %.4g Mp %.4g Emax %.4g xion %.4g Mion %.4g Iion %.4g I_k %.4g", volts, global(s, QStringLiteral("semi.In")), global(s, QStringLiteral("semi.Ip")),
+                  global(s, QStringLiteral("semi.Mn")), global(s, QStringLiteral("semi.Mp")), global(s, QStringLiteral("semi.Emax")), global(s, QStringLiteral("semi.xion")),
+                  global(s, QStringLiteral("semi.Mion")), global(s, QStringLiteral("semi.Iion")), global(s, QStringLiteral("semi.I_k")));
+        }
