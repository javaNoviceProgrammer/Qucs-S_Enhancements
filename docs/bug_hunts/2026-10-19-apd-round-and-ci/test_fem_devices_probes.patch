+    void huntMionWithoutGeneration()
+    {
+        for (const char* volts : {"0", "-1", "-40"}) {
+            QByteArray json = diode(QStringLiteral("1e16[1/cm^3]"), QStringLiteral("4"), QStringLiteral(R"(, {"type": "impact", "selection": {"all": true}})"),
+                                    QStringLiteral(R"({"type": "stationary"})"), QStringLiteral("0.1"));
+            json.replace(R"({"name": "Va", "expression": "0[V]"})", QStringLiteral(R"({"name": "Va", "expression": "%1[V]"})").arg(QLatin1String(volts)).toUtf8());
+            const Run r = run(modelOf(json));
+            if (!r.error.isEmpty()) { qInfo("%s V: %s", volts, qPrintable(r.error)); continue; }
+            const Solution& s = *r.solution;
+            qInfo("%s V: Iion %.4g Igen %.4g Mion %.6g xion %.4g yion %.4g In %.4g Ip %.4g Mp %.4g Mn %.4g I_k %.4g", volts, global(s, QStringLiteral("semi.Iion")), global(s, QStringLiteral("semi.Igen")),
+                  global(s, QStringLiteral("semi.Mion")), global(s, QStringLiteral("semi.xion")), global(s, QStringLiteral("semi.yion")), global(s, QStringLiteral("semi.In")),
+                  global(s, QStringLiteral("semi.Ip")), global(s, QStringLiteral("semi.Mp")), global(s, QStringLiteral("semi.Mn")), global(s, QStringLiteral("semi.I_k")));
+        }
+    }
