+    void huntDrivingChoice()
+    {
+        for (const char* d : {"field", "fermi", "Fermi", "grad phi", "current", "", "1"}) {
+            QByteArray json = diode(QStringLiteral("1e16[1/cm^3]"), QStringLiteral("4"), QStringLiteral(R"(, {"type": "impact", "driving": "%1", "selection": {"all": true}})").arg(QLatin1String(d)),
+                                    QStringLiteral(R"({"type": "stationary"})"), QStringLiteral("0.1"));
+            json.replace(R"({"name": "Va", "expression": "0[V]"})", R"({"name": "Va", "expression": "-40[V]"})");
+            QString why;
+            std::optional<Model> m = Model::fromJson(json, &why);
+            if (!m) { qInfo("driving '%s': refused: %s", d, qPrintable(why)); continue; }
+            const Run r = run(*m);
+            qInfo("driving '%s': fromJson says '%s'; error '%s' warnings '%s' In %.5g Iion %.4g", d, qPrintable(why), qPrintable(r.error), qPrintable(r.study.warnings.join(QLatin1String("; "))),
+                  r.solution ? global(*r.solution, QStringLiteral("semi.In")) : NAN, r.solution ? global(*r.solution, QStringLiteral("semi.Iion")) : NAN);
+        }
+    }
+
