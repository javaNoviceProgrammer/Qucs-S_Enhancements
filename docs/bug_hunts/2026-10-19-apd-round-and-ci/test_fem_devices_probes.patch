+          {"type": "ground", "selection": {"of": ["bar"], "side": "right"}}]}],
+        "mesh": {"size": "coarse"}}],
+      "studies": [{"type": "study", "steps": [{"type": "sweep", "parameters": [[%1]] %2}, {"type": "stationary"}]}]})json");
+        const QStringList sweeps = {QStringLiteral(R"("L", "10, 15, -5, 25, 30, 40", "mm")"), QStringLiteral(R"("L", "10, 15, 0, 25, 30, 40", "mm")"),
+                                    QStringLiteral(R"("s", "1e6, 2e6, 0, 4e6, 5e6", "S/m")"), QStringLiteral(R"("s", "1e6, 2e6, -1e6, 4e6", "S/m")"),
+                                    QStringLiteral(R"("L", "-5, 10, 15", "mm")")};
+        for (const QString& sw : sweeps)
+            for (const char* par : {"", R"(, "parallel": 4)"}) {
+                const Run r = run(modelOf(json.arg(sw, QLatin1String(par)).toUtf8()));
+                QStringList g;
+                for (const auto& sol : r.study.solutions) g << QStringLiteral("%1=%2").arg(sol->label).arg(sol->global(QStringLiteral("ec.G11")).value_or(NAN), 0, 'g', 5);
+                qInfo("%s%s: error '%s' stopped '%s' kept %d: %s", qPrintable(sw), par, qPrintable(r.study.error), qPrintable(r.study.stopped), int(r.study.solutions.size()), qPrintable(g.join(QLatin1String(", "))));
+            }
+    }
