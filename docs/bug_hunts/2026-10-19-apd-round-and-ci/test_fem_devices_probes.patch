+                    qInfo("srh %d %s V currents %d: I_k %.5g I_a %.5g Iion %.5g Igen %.5g Mion %.5g Mn %.4g Mp %.4g", int(*srh != 0), volts, on, global(s, QStringLiteral("semi.I_k")), global(s, QStringLiteral("semi.I_a")),
+                          global(s, QStringLiteral("semi.Iion")), global(s, QStringLiteral("semi.Igen")), global(s, QStringLiteral("semi.Mion")), global(s, QStringLiteral("semi.Mn")), global(s, QStringLiteral("semi.Mp")));
+                }
+    }
