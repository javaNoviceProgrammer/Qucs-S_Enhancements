+    // ---- hunt probes (throwaway) ----
+    void huntWeakLightSweep()
+    {
+        const QString light = QStringLiteral(R"x(, {"type": "generation", "G": "G0*(x > 3.1[um])*(x < 3.6[um])", "selection": {"all": true}},
+          {"type": "srh", "source": "user", "taun": "1[us]", "taup": "1[us]", "selection": {"all": true}})x");
+        const QStringList levels = {QStringLiteral("0"), QStringLiteral("1e14"), QStringLiteral("1e16"), QStringLiteral("1e18"), QStringLiteral("1e20"), QStringLiteral("1e22")};
+        QByteArray json = diode(QStringLiteral("1e16[1/cm^3]"), QStringLiteral("4"), light,
+                                QStringLiteral(R"x({"type": "sweep", "parameters": [["G0", "%1", "1/(m^3*s)"]]}, {"type": "stationary"})x").arg(levels.join(QLatin1String(", "))), QStringLiteral("0.05"));
+        json.replace(R"("parameters": [{"name": "Va", "expression": "0[V]"}])",
+                     R"x("parameters": [{"name": "Va", "expression": "-1[V]"}, {"name": "G0", "expression": "0[1/(m^3*s)]"}])x");
+        const Run r = run(modelOf(json));
+        QVERIFY2(r.error.isEmpty(), qPrintable(r.error));
+        for (int k = 0; k < levels.size(); ++k) {
+            QByteArray one = diode(QStringLiteral("1e16[1/cm^3]"), QStringLiteral("4"), light, QStringLiteral(R"({"type": "stationary"})"), QStringLiteral("0.05"));
+            one.replace(R"("parameters": [{"name": "Va", "expression": "0[V]"}])",
+                        QStringLiteral(R"x("parameters": [{"name": "Va", "expression": "-1[V]"}, {"name": "G0", "expression": "%1[1/(m^3*s)]"}])x").arg(levels[k]).toUtf8());
+            const Run alone = run(modelOf(one));
+            const double swept = global(*r.study.solutions[std::size_t(k)], QStringLiteral("semi.I_k")), single = global(*alone.solution, QStringLiteral("semi.I_k"));
+            qInfo("G0 %s: swept %.6e A, alone %.6e A, ratio %.6f | %s", qPrintable(levels[k]), swept, single, swept / single,
+                  qPrintable(r.study.solutions[std::size_t(k)]->log.join(QLatin1String(" | ")).left(200)));
+        }
+    }
