+    void huntNearBreakdownSweep()
+    {
+        for (const char* h : {"0.05", "0.04"}) {
+            QByteArray json = diode(QStringLiteral("1e16[1/cm^3]"), QStringLiteral("4"),
+                                    QStringLiteral(R"(, {"type": "impact", "selection": {"all": true}}, {"type": "srh", "source": "user", "taun": "1[us]", "taup": "1[us]", "selection": {"all": true}})"),
+                                    QStringLiteral(R"({"type": "sweep", "parameters": [["Va", "-49, -50, -50.1, -50.2, -50.3, -50.4, -50.5, -50.6, -50.7, -50.8, -50.9, -51, -51.1, -51.2, -51.3, -51.4", "V"]]}, {"type": "stationary"})"), QLatin1String(h));
+            QElapsedTimer t;
+            t.start();
+            const Run r = run(modelOf(json));
+            static const QRegularExpression reached(QStringLiteral("\\((\\d+) of Newton's(; (\\d+) tried again)?"));
+            QStringList pts;
+            for (const auto& sol : r.study.solutions) {
+                const QRegularExpressionMatch m = reached.match(sol->log.join(QLatin1Char(' ')));
+                pts << QStringLiteral("%1 In %2 N%3%4").arg(sol->label.mid(5)).arg(global(*sol, QStringLiteral("semi.In")), 0, 'f', 4).arg(m.hasMatch() ? m.captured(1) : QStringLiteral("1st")).arg(m.captured(3).isEmpty() ? QString() : QStringLiteral(" r") + m.captured(3));
+            }
+            qInfo("hmax %s %lld ms: %s | stopped '%s' error '%s'", h, t.elapsed(), qPrintable(pts.join(QLatin1String(", "))), qPrintable(r.study.stopped), qPrintable(r.study.error));
+        }
+    }
+
+    void huntIionByDriving()
+    {
+        for (const char* drv : {"field", "fermi", "current"}) {
+            double I[2] = {0, 0}, ion = 0;
+            for (int on = 0; on < 2; ++on) {
+                QByteArray json = diode(QStringLiteral("1e16[1/cm^3]"), QStringLiteral("4"),
+                                        QStringLiteral(R"(, {"type": "impact", "driving": "%2", "currents": %1, "selection": {"all": true}})").arg(on ? QStringLiteral("true") : QStringLiteral("false"), QLatin1String(drv)),
+                                        QStringLiteral(R"({"type": "stationary"})"), QStringLiteral("0.05"));
+                json.replace(R"({"name": "Va", "expression": "0[V]"})", R"({"name": "Va", "expression": "-40[V]"})");
+                const Run r = run(modelOf(json));
+                if (!r.error.isEmpty()) { qInfo("%s", qPrintable(r.error)); continue; }
+                I[on] = global(*r.solution, QStringLiteral("semi.I_k"));
+                if (on) ion = global(*r.solution, QStringLiteral("semi.Iion"));
+            }
+            qInfo("driving %s, no SRH, -40 V: I off %.5g, on %.5g, dI %.4g, Iion %.4g (%.1f times)", drv, I[0], I[1], I[1] - I[0], ion, ion / (I[1] - I[0]));
+        }
+    }
+
+    void huntHandoffWithFrequency()
+    {
+        for (const char* more : {"", R"(, {"type": "frequency", "frequencies": "1[MHz]"})"}) {
+            QByteArray json = diode(QStringLiteral("1e16[1/cm^3]"), QStringLiteral("4"),
+                                    QStringLiteral(R"(, {"type": "srh", "source": "user", "taun": "1[us]", "taup": "1[us]", "selection": {"all": true}})"),
+                                    QStringLiteral(R"({"type": "sweep", "parameters": [["Va", "-1, -3, -5, -7, -9, -11", "V"]]}, {"type": "stationary"}%1)").arg(QLatin1String(more)), QStringLiteral("0.05"));
+            QStringList told;
+            const StudyRun r = toldRun(modelOf(json), &told);
+            QStringList pts;
+            for (const auto& sol : r.solutions) pts << QStringLiteral("%1: %2").arg(sol->label, sol->log.filter(QStringLiteral("reached")).join(QLatin1String(" ")).mid(14, 50));
+            QStringList firsts;
+            for (const QString& w : told) if (w.contains(QLatin1String("(step 1, ")) && w.contains(QLatin1String("Newton's step 1,"))) firsts << w.section(QLatin1String(" - a at "), 1).section(QLatin1Char(';'), 0, 0);
+            qInfo("%s: %s | first steps: %s | %s", *more ? "with frequency" : "stationary alone", qPrintable(pts.join(QLatin1String(" | "))), qPrintable(firsts.join(QLatin1String("; "))), qPrintable(r.error));
+        }
+    }
