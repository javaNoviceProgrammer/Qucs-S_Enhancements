+    void huntEveryTabTall()
+    {
+        QucsApp app(false);
+        MainGuard mainGuard(&app);
+        QucsSettingsDialog dlg(&app);
+        auto* tabs = dlg.findChild<QTabWidget*>();
+        dlg.resize(900, 1000);
+        dlg.show();
