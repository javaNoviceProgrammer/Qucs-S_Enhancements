{
 "format": "qucs-s multiphysics 1",
 "title": "A VCSEL's cavity modes",
 "description": "An oxide-confined 980 nm VCSEL's cold cavity, full-vector, one azimuthal order at a time: GaAs and Al0.9Ga0.1As quarter-wave mirrors (25 pairs below, 20 above), a one-wave Al0.3Ga0.7As cavity, a 30 nm oxide layer with a 2 µm aperture, perfectly matched layers along r, below and above. Order m 1, the three modes nearest 977 nm: HE11 at 978.52 nm, Q 16 000 (the aperture's confinement 1.5 nm below the mirrors' 980 nm), a ring at 974.24 nm (EH11's, with some of HE12's on the axis) and HE12 at 973.43 nm, its field highest on the axis and nought near r = 1 µm - Q from the complex eigenfrequency. Set m to 0 for TM01 and TE01 (976.83 and 976.46 nm), to 2 for HE21 (976.66 nm): the LP11 group split by 0.38 nm. A mesh twice as fine along r moves HE11 0.13 nm (the oxide's corners).",
 "parameters": [
  {
   "name": "lambda0",
   "expression": "980[nm]",
   "description": "the design wavelength"
  },
  {
   "name": "nH",
   "expression": "3.52",
   "description": "GaAs's index at 980 nm"
  },
  {
   "name": "nL",
   "expression": "2.98",
   "description": "Al0.9Ga0.1As's"
  },
  {
   "name": "nC",
   "expression": "3.40",
   "description": "the cavity's (Al0.3Ga0.7As)"
  },
  {
   "name": "nAp",
   "expression": "2.95",
   "description": "AlAs's, in the aperture"
  },
  {
   "name": "nOx",
   "expression": "1.60",
   "description": "its oxide's, round it"
  },
  {
   "name": "tH",
   "expression": "lambda0/(4*nH)",
   "description": "a quarter wave of GaAs"
  },
  {
   "name": "tL",
   "expression": "lambda0/(4*nL)",
   "description": "of Al0.9Ga0.1As"
  },
  {
   "name": "tC",
   "expression": "lambda0/nC",
   "description": "the cavity: one wave"
  },
  {
   "name": "tOx",
   "expression": "30[nm]",
   "description": "the oxidized layer"
  },
  {
   "name": "Nb",
   "expression": "25",
   "description": "pairs below"
  },
  {
   "name": "Nt",
   "expression": "20",
   "description": "pairs above"
  },
  {
   "name": "a",
   "expression": "2[um]",
   "description": "the aperture's radius"
  },
  {
   "name": "R",
   "expression": "4[um]",
   "description": "the window's radius"
  },
  {
   "name": "d",
   "expression": "1[um]",
   "description": "the absorbing layers' thickness, along r"
  },
  {
   "name": "dz",
   "expression": "0.5[um]",
   "description": "along z"
  },
  {
   "name": "s",
   "expression": "0.6[um]",
   "description": "substrate and air"
  },
  {
   "name": "yc",
   "expression": "Nb*(tH + tL)",
   "description": "the cavity's bottom"
  },
  {
   "name": "yt",
   "expression": "yc + tC + Nt*(tH + tL)",
   "description": "the top mirror's top"
  }
 ],
 "components": [
