{
 "format": "qucs-s multiphysics 1",
 "title": "A VCSEL's threshold and light",
 "description": "The 980 nm oxide VCSEL of vcsel_modes.qfem made a laser: three 8 nm In0.2Ga0.8As wells in GaAs barriers at its cavity's middle (its spacers Al0.3Ga0.7As, the cavity one wave), its mirrors doped - n below, p above, 2e18 per cm³, their layers one graded medium electrically -, a gold ring contact on top from r 2.5 µm and the oxide's 2 µm aperture taking the current to the wells. Its cavity's mode by an Eigenfrequency step: HE11 at 980.29 nm, Q 15 800 (the wells' absorption their gain's, not the cold cavity's); the wells' TE gain at its photon energy, 1.2648 eV, tabulated against their carriers (parabolic bands, a sech line of 6.6 meV, twelve states: transparent at 1.09e18 per cm³); then the Laser L-I step: the ring's voltage from 1.20 to 1.90 V, the semiconductor's carriers and the mode's photons solved together at each point. Threshold 47 µA at 1.37 V (the mode's gain at threshold 409 per cm, Γ 0.042), then 0.60 W/A - 0.47 photons out the top an electron: 48 % of the cavity's loss is the top's, its bottom mirror's 25 pairs leaking 41 % into the substrate (η 0.484, the mode's Poynting flux) -, 0.82 mW at 1.42 mA. Its cavity's rows ten (its current at 1.9 V within 1 % of four times as many, its heterojunctions abrupt), its SRH lifetimes its feature's 5 ns. Light against current, the electrons and the stimulated recombination at the last point, the mode.",
 "parameters": [
  {
   "name": "lambda0",
   "expression": "980[nm]",
   "description": "the design wavelength"
  },
  {
   "name": "nH",
   "expression": "3.52",
   "description": "GaAs's index at 980 nm"
  },
  {
   "name": "nL",
   "expression": "2.98",
   "description": "Al0.9Ga0.1As's"
  },
  {
   "name": "nC",
   "expression": "3.40",
   "description": "the cavity's spacers' (Al0.3Ga0.7As)"
  },
  {
   "name": "nW",
   "expression": "3.60",
   "description": "the wells' (In0.2Ga0.8As)"
  },
  {
   "name": "nAp",
   "expression": "2.95",
   "description": "AlAs's, in the aperture"
  },
  {
   "name": "nOx",
   "expression": "1.60",
   "description": "its oxide's, round it"
  },
  {
   "name": "tH",
   "expression": "lambda0/(4*nH)",
   "description": "a quarter wave of GaAs"
  },
  {
   "name": "tL",
   "expression": "lambda0/(4*nL)",
   "description": "of Al0.9Ga0.1As"
  },
  {
   "name": "tw",
   "expression": "8[nm]",
   "description": "a well's thickness"
  },
  {
   "name": "tb",
   "expression": "10[nm]",
   "description": "a barrier's (GaAs)"
  },
  {
   "name": "ta",
   "expression": "3*tw + 4*tb",
   "description": "the wells and barriers"
  },
  {
   "name": "ts",
   "expression": "(lambda0 - 3*tw*nW - 4*tb*nH)/(2*nC)",
   "description": "each spacer: the cavity one wave"
  },
  {
   "name": "tOx",
   "expression": "30[nm]",
   "description": "the oxidized layer"
  },
  {
   "name": "Nb",
   "expression": "25",
   "description": "pairs below"
  },
  {
   "name": "Nt",
   "expression": "20",
   "description": "pairs above"
  },
  {
   "name": "a",
   "expression": "2[um]",
   "description": "the aperture's radius"
  },
  {
   "name": "rc",
   "expression": "2.5[um]",
   "description": "the ring contact's inner radius"
  },
  {
   "name": "tm",
   "expression": "0.1[um]",
   "description": "its gold's thickness"
  },
  {
   "name": "R",
   "expression": "4[um]",
   "description": "the window's radius"
  },
  {
   "name": "d",
   "expression": "1[um]",
   "description": "the absorbing layers' thickness, along r"
  },
  {
   "name": "dz",
   "expression": "0.5[um]",
   "description": "along z"
  },
  {
   "name": "s",
   "expression": "0.6[um]",
   "description": "substrate and air"
  },
  {
   "name": "yc",
   "expression": "Nb*(tH + tL)",
   "description": "the cavity's bottom"
  },
  {
   "name": "ya",
   "expression": "yc + ts",
   "description": "the first barrier's bottom"
  },
  {
   "name": "yt",
   "expression": "yc + 2*ts + ta + Nt*(tH + tL)",
   "description": "the top mirror's top"
  },
  {
   "name": "Ndop",
   "expression": "2e18[1/cm^3]",
   "description": "the mirrors' doping"
  }
 ],
