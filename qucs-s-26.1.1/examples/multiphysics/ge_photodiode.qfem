                        "-2",
                        "-1"
                    ],
                    "size": [
                        "4",
                        "1"
                    ]
                },
                {
                    "type": "rectangle",
                    "label": "cladding",
                    "position": [
                        "-2",
                        "0"
                    ],
                    "size": [
                        "4",
                        "1.6"
                    ]
                },
                {
                    "type": "rectangle",
                    "label": "slab",
                    "position": [
                        "-1.5",
                        "0"
                    ],
                    "size": [
                        "3",
                        "0.22"
                    ]
                },
                {
                    "type": "rectangle",
                    "label": "pplus",
                    "position": [
                        "-w/2 - 0.2",
                        "0.22"
                    ],
                    "size": [
                        "0.2",
                        "0.45"
                    ]
                },
                {
                    "type": "rectangle",
                    "label": "absorber",
                    "position": [
                        "-w/2",
                        "0.22"
                    ],
                    "size": [
                        "w",
                        "0.45"
                    ]
                },
                {
                    "type": "rectangle",
                    "label": "nplus",
                    "position": [
                        "w/2",
                        "0.22"
                    ],
                    "size": [
                        "0.2",
                        "0.45"
                    ]
                },
                {
                    "type": "form union"
                }
            ],
            "materials": [
                {
                    "material": "Silicon dioxide",
                    "selection": {
                        "only": [
                            "box",
                            "cladding"
                        ]
                    }
                },
                {
                    "material": "Silicon",
                    "selection": {
                        "only": [
                            "slab"
                        ]
                    }
                },
                {
                    "material": "Germanium on silicon",
                    "selection": {
                        "only": [
                            "pplus",
                            "absorber",
                            "nplus"
                        ]
                    }
                }
            ],
            "physics": [
                {
                    "type": "semiconductor",
                    "tag": "semi",
                    "selection": {
                        "only": [
                            "slab",
                            "pplus",
                            "absorber",
                            "nplus"
                        ]
                    },
                    "features": [
                        {
                            "type": "model",
                            "label": "Germanium's saturated velocities",
                            "saturation": true,
                            "vsatn": "6e6[cm/s]",
                            "vsatp": "6e6[cm/s]",
                            "selection": {
                                "only": [
                                    "pplus",
                                    "absorber",
                                    "nplus"
                                ]
                            }
                        },
                        {
                            "type": "doping",
                            "label": "p+ germanium",
                            "dopant": "acceptor",
                            "N0": "1e19[1/cm^3]",
                            "selection": {
                                "only": [
                                    "pplus"
                                ]
                            }
                        },
                        {
                            "type": "doping",
                            "label": "n+ germanium",
                            "dopant": "donor",
                            "N0": "1e19[1/cm^3]",
                            "selection": {
                                "only": [
                                    "nplus"
                                ]
                            }
                        },
                        {
                            "type": "doping",
                            "label": "Background",
                            "dopant": "acceptor",
                            "N0": "1e15[1/cm^3]",
                            "selection": {
                                "only": [
                                    "slab",
                                    "absorber"
                                ]
                            }
                        },
                        {
                            "type": "srh",
                            "label": "Recombination",
                            "selection": {
                                "all": true
                            }
                        },
                        {
                            "type": "optical",
                            "label": "The light",
                            "mode": "emw",
                            "P0": "P",
                            "selection": {
                                "only": [
                                    "pplus",
                                    "absorber",
                                    "nplus"
                                ]
                            }
                        },
                        {
                            "type": "ohmic",
                            "label": "Anode",
                            "name": "a",
                            "V0": "Va",
                            "selection": {
                                "of": [
                                    "pplus"
                                ],
                                "side": "top"
                            }
                        },
                        {
                            "type": "ohmic",
                            "label": "Cathode",
                            "name": "k",
                            "V0": "0[V]",
                            "selection": {
                                "of": [
                                    "nplus"
                                ],
                                "side": "top"
                            }
                        }
                    ]
                },
                {
                    "type": "modes",
                    "tag": "emw",
                    "features": [
                        {
                            "type": "wave",
                            "label": "Germanium's direct gap",
                            "electroabsorption": true,
                            "selection": {
                                "only": [
                                    "pplus",
                                    "absorber",
                                    "nplus"
                                ]
                            }
                        }
                    ]
                }
            ],
            "mesh": {
                "size": "normal",
                "custom": true,
                "hmax": "0.25",
                "features": [
                    {
                        "type": "size",
                        "level": "domain",
                        "selection": {
                            "only": [
                                "pplus",
                                "absorber",
                                "nplus",
                                "slab"
                            ]
                        },
                        "hmax": "0.04"
                    }
                ]
            }
        }
    ],
    "studies": [
        {
            "type": "study",
            "tag": "std1",
            "label": "Dark Current",
            "steps": [
                {
                    "type": "sweep",
                    "parameters": [
                        [
                            "Va",
                            "0.2, 0.1, 0, -0.5, -1, -2, -3",
                            "V"
                        ]
                    ]
                },
                {
                    "type": "stationary",
                    "physics": [
                        "semi"
                    ]
                }
            ]
        },
        {
            "type": "study",
            "tag": "std2",
            "label": "Lit, Modulated",
            "steps": [
                {
                    "type": "stationary",
                    "physics": [
                        "semi"
                    ]
                },
                {
                    "type": "mode",
                    "physics": [
                        "emw"
                    ],
                    "frequency": "lambda",
                    "modes": 1,
                    "neff": "3.9"
                },
                {
                    "type": "stationary",
                    "physics": [
                        "semi"
                    ]
                },
                {
                    "type": "frequency",
                    "physics": [
                        "semi"
                    ],
                    "frequencies": "logspace(1[GHz], 200[GHz], 16)"
                }
            ]
        },
        {
            "type": "study",
            "tag": "std3",
            "label": "Spectral Response",
            "steps": [
                {
                    "type": "sweep",
                    "parameters": [
                        [
                            "lambda",
                            "range(1500, 20, 1640)",
                            "nm"
                        ]
                    ]
                },
                {
                    "type": "stationary",
                    "physics": [
                        "semi"
                    ]
                },
                {
                    "type": "mode",
                    "physics": [
                        "emw"
                    ],
                    "frequency": "lambda",
                    "modes": 1,
                    "neff": "3.9"
                },
                {
                    "type": "stationary",
                    "physics": [
                        "semi"
                    ]
                }
            ]
        }
    ],
    "results": {
