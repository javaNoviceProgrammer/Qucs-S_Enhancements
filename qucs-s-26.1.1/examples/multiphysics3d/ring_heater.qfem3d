{
    "format": "qucs-s multiphysics 3d 1",
    "title": "A heater over a ring",
    "description": "Two coupled silicon racetracks (a strip 410 x 220 nm on 2 µm of buried oxide), each under a Ti/TiN heater loop 600 nm above it and 320 nm of silica over all - the double ring of C. L. Manganelli et al. (IEEE Photon. Technol. Lett. 30, 1601, 2018) -, both heaters making P, the substrate's back held at 20 °C. Its racetracks are 28.57 µm long, c/(n_g FSR) of its 2.4 THz with the strip's group index, 4.372 by the 2D mode solver. One FSR is ΔT = λ/(L dn/dT), 301 K at the paper's 1.8e-4 /K: the waveguides rise 14.4 K per mW of their heaters here (order 1; 14.6 at order 2), some 21 mW per FSR per ring - the paper's 3D simulation 21.2, its measurement 20 to 22. The loops' peak is twice their waveguides' rise. Not given by the paper: the bends' radius (3 µm here; 2.5 to 3.5 move the tuning 5 % either way), the leads and the substrate; the loops are drawn as wide as the waveguides (434 nm in the paper: 0.1 % in the answer, a mesh twenty times the size).",
    "parameters": [
        {"name": "L", "expression": "28.573[um]", "description": "a racetrack's length"},
        {"name": "R", "expression": "3[um]", "description": "its bends' radius"},
        {"name": "S", "expression": "(L - 2*pi*R)/2", "description": "its straights' length"},
        {"name": "w", "expression": "0.41[um]", "description": "the strip's width"},
        {"name": "gap", "expression": "0.25[um]", "description": "the racetracks' gap"},
        {"name": "dx", "expression": "R + w/2 + gap/2", "description": "each racetrack's middle from the device's"},
        {"name": "Hs", "expression": "100[um]", "description": "the substrate's depth"},
        {"name": "P", "expression": "1[mW]", "description": "each heater's power"}
    ],
    "components": [
        {
            "unit": "um",
            "space": "3D",
            "geometry": [
                {
                    "type": "box",
                    "label": "substrate",
                    "base": "center",
                    "position": ["0", "0"],
                    "size": ["80[um]", "80[um]"],
                    "z": "0",
                    "height": "Hs"
                },
                {
                    "type": "box",
                    "label": "oxide",
                    "base": "center",
                    "position": ["0", "0"],
                    "size": ["80[um]", "80[um]"],
                    "z": "Hs",
                    "height": "2[um] + 0.22[um] + 0.6[um] + 0.12[um] + 0.32[um]"
                },
                {
                    "type": "extrude",
                    "label": "ring1",
                    "z": "Hs + 2[um]",
                    "height": "0.22[um]",
                    "features": [
                        {"type": "rectangle", "label": "ring1_or", "base": "center", "position": ["-dx", "0"], "size": ["2*R + w", "S"]},
                        {"type": "circle", "label": "ring1_ot", "center": ["-dx", "S/2"], "radius": "R + w/2"},
                        {"type": "circle", "label": "ring1_ob", "center": ["-dx", "-S/2"], "radius": "R + w/2"},
                        {"type": "union", "label": "ring1_o", "input": ["ring1_or", "ring1_ot", "ring1_ob"]},
                        {"type": "rectangle", "label": "ring1_ir", "base": "center", "position": ["-dx", "0"], "size": ["2*R - w", "S"]},
                        {"type": "circle", "label": "ring1_it", "center": ["-dx", "S/2"], "radius": "R - w/2"},
                        {"type": "circle", "label": "ring1_ib", "center": ["-dx", "-S/2"], "radius": "R - w/2"},
                        {"type": "union", "label": "ring1_i", "input": ["ring1_ir", "ring1_it", "ring1_ib"]},
                        {"type": "difference", "label": "ring1_band", "input": ["ring1_o"], "tools": ["ring1_i"]}
                    ]
                },
                {
                    "type": "extrude",
                    "label": "ring2",
                    "z": "Hs + 2[um]",
                    "height": "0.22[um]",
                    "features": [
                        {"type": "rectangle", "label": "ring2_or", "base": "center", "position": ["dx", "0"], "size": ["2*R + w", "S"]},
                        {"type": "circle", "label": "ring2_ot", "center": ["dx", "S/2"], "radius": "R + w/2"},
                        {"type": "circle", "label": "ring2_ob", "center": ["dx", "-S/2"], "radius": "R + w/2"},
                        {"type": "union", "label": "ring2_o", "input": ["ring2_or", "ring2_ot", "ring2_ob"]},
                        {"type": "rectangle", "label": "ring2_ir", "base": "center", "position": ["dx", "0"], "size": ["2*R - w", "S"]},
                        {"type": "circle", "label": "ring2_it", "center": ["dx", "S/2"], "radius": "R - w/2"},
                        {"type": "circle", "label": "ring2_ib", "center": ["dx", "-S/2"], "radius": "R - w/2"},
                        {"type": "union", "label": "ring2_i", "input": ["ring2_ir", "ring2_it", "ring2_ib"]},
                        {"type": "difference", "label": "ring2_band", "input": ["ring2_o"], "tools": ["ring2_i"]}
                    ]
                },
                {
                    "type": "extrude",
                    "label": "heater1",
                    "z": "Hs + 2.82[um]",
                    "height": "0.12[um]",
                    "features": [
                        {"type": "rectangle", "label": "heater1_or", "base": "center", "position": ["-dx", "0"], "size": ["2*R + w", "S"]},
                        {"type": "circle", "label": "heater1_ot", "center": ["-dx", "S/2"], "radius": "R + w/2"},
                        {"type": "circle", "label": "heater1_ob", "center": ["-dx", "-S/2"], "radius": "R + w/2"},
                        {"type": "union", "label": "heater1_o", "input": ["heater1_or", "heater1_ot", "heater1_ob"]},
                        {"type": "rectangle", "label": "heater1_ir", "base": "center", "position": ["-dx", "0"], "size": ["2*R - w", "S"]},
                        {"type": "circle", "label": "heater1_it", "center": ["-dx", "S/2"], "radius": "R - w/2"},
                        {"type": "circle", "label": "heater1_ib", "center": ["-dx", "-S/2"], "radius": "R - w/2"},
                        {"type": "union", "label": "heater1_i", "input": ["heater1_ir", "heater1_it", "heater1_ib"]},
                        {"type": "difference", "label": "heater1_band", "input": ["heater1_o"], "tools": ["heater1_i"]}
                    ]
                },
                {
                    "type": "extrude",
                    "label": "heater2",
                    "z": "Hs + 2.82[um]",
                    "height": "0.12[um]",
                    "features": [
                        {"type": "rectangle", "label": "heater2_or", "base": "center", "position": ["dx", "0"], "size": ["2*R + w", "S"]},
                        {"type": "circle", "label": "heater2_ot", "center": ["dx", "S/2"], "radius": "R + w/2"},
                        {"type": "circle", "label": "heater2_ob", "center": ["dx", "-S/2"], "radius": "R + w/2"},
                        {"type": "union", "label": "heater2_o", "input": ["heater2_or", "heater2_ot", "heater2_ob"]},
                        {"type": "rectangle", "label": "heater2_ir", "base": "center", "position": ["dx", "0"], "size": ["2*R - w", "S"]},
                        {"type": "circle", "label": "heater2_it", "center": ["dx", "S/2"], "radius": "R - w/2"},
                        {"type": "circle", "label": "heater2_ib", "center": ["dx", "-S/2"], "radius": "R - w/2"},
                        {"type": "union", "label": "heater2_i", "input": ["heater2_ir", "heater2_it", "heater2_ib"]},
                        {"type": "difference", "label": "heater2_band", "input": ["heater2_o"], "tools": ["heater2_i"]}
                    ]
                },
                {"type": "form union"}
            ],
            "materials": [
                {
                    "material": "Silicon",
                    "selection": {"only": ["substrate", "ring1", "ring2"]}
                },
                {
                    "material": "Silicon dioxide",
                    "selection": {"only": ["oxide"]}
                },
                {
                    "label": "Ti/TiN",
                    "k": "29[W/(m*K)]",
                    "selection": {"only": ["heater1", "heater2"]}
                }
            ],
            "physics": [
                {
                    "type": "heat",
                    "tag": "ht",
                    "order": "1",
                    "features": [
                        {
                            "type": "source",
                            "label": "The heaters",
                            "kind": "power",
                            "P0": "2*P",
                            "selection": {"only": ["heater1", "heater2"]}
                        },
                        {
                            "type": "temperature",
                            "label": "The substrate's back",
                            "T0": "293.15[K]",
                            "selection": {"of": ["substrate"], "side": "bottom"}
                        }
                    ]
                }
            ],
            "mesh": {
                "size": "normal",
                "custom": true,
                "hmax": "8",
                "growth": "1.3",
                "features": [
                    {
                        "type": "size",
                        "level": "edge",
                        "selection": {"of": ["ring1", "ring2", "heater1", "heater2"]},
                        "hmax": "0.3"
                    }
                ]
            }
        }
    ],
    "studies": [
        {
            "type": "study",
            "label": "Study 1",
            "steps": [
                {"type": "stationary"}
            ]
        }
    ],
    "results": {"plots": [], "derived": []}
}
