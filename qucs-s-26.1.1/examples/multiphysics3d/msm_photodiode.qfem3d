                            "selection": {"of": ["combB"], "side": "bottom"}
                        }
                    ]
                }
            ],
            "mesh": {
                "size": "normal",
                "custom": true,
                "hmax": "2",
                "growth": "1.3",
                "features": [
                    {
                        "type": "size",
                        "level": "edge",
                        "selection": {"of": ["combA", "combB"]},
                        "hmax": "0.1"
                    }
                ]
            }
