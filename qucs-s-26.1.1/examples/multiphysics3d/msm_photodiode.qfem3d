                        },
                        {"type": "rectangle", "label": "fingerA", "position": ["0", "0"], "size": ["w", "L"]},
                        {"type": "array", "label": "fingersA", "input": ["fingerA"], "count": ["N", "1"], "displacement": ["2*(w + s)", "0"]}
                    ]
                },
                {
                    "type": "extrude",
                    "label": "combB",
                    "z": "H",
                    "height": "t",
                    "features": [
                        {
                            "type": "rectangle",
                            "label": "barB",
                            "position": ["0", "L + s"],
                            "size": ["(2*N - 1)*(w + s) + w", "2[um]"]
                        },
                        {"type": "rectangle", "label": "fingerB", "position": ["w + s", "s"], "size": ["w", "L"]},
                        {"type": "array", "label": "fingersB", "input": ["fingerB"], "count": ["N", "1"], "displacement": ["2*(w + s)", "0"]}
                    ]
                },
                {"type": "form union"}
            ],
            "materials": [
                {
                    "material": "Gallium arsenide",
                    "selection": {"only": ["substrate"]}
                },
                {
                    "material": "Air",
                    "selection": {"only": ["air", "combA", "combB"]}
                }
            ],
            "physics": [
